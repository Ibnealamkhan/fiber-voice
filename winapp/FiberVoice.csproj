<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FiberVoice</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Product>Fiber Voice</Product>
    <Title>Fiber Voice</Title>
    <AssemblyTitle>Fiber Voice</AssemblyTitle>
    <Description>Fiber Voice desktop calling app</Description>
    <Company>Fiber Voice</Company>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <EmbeddedResource Include="build/gateway.zip" LogicalName="FiberVoice.Gateway.zip" />
    <EmbeddedResource Include="AppIcon.ico" LogicalName="FiberVoice.AppIcon.ico" />
  </ItemGroup>
  <!-- WebView2 also adds a WPF assembly; this shell uses WinForms only. -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
